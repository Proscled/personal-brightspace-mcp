(version 1)
(allow default)
(deny network*)
(deny appleevent-send)
(deny file-read-data)
(allow file-read-data (literal "/") (literal "/System/Volumes/Data")
 (subpath "/System/Library") (subpath "/System/iOSSupport") (subpath "/System/Volumes/Preboot/Cryptexes")
 (subpath "/usr/bin") (subpath "/usr/lib") (subpath "/usr/share") (subpath "/usr/libexec")
 (subpath "/Library/Fonts") (subpath "/Library/ColorSync") (subpath "/Library/Apple")
 (subpath "/private/var/db/timezone") (subpath "/private/etc/fonts")
 (literal "/dev/null") (literal "/dev/urandom") (literal "/dev/random")
 (subpath (param "WORK")) (literal (param "HELPER")) (subpath (param "APP")))
(deny file-write*)
(allow file-write* (subpath (param "WORK")) (literal "/dev/null"))
(deny process-exec)
(allow process-exec (literal (param "EXE")))
